            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        hrm_index_right: hrm_index_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 53 60 61 62 63 64 70 71 72 73 74 75 76 77 78 79 80 81>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        select_next_word: select_next_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_CONTROL>
                , <&macro_press &kp LEFT_SHIFT>
                , <&macro_tap &kp RIGHT_ARROW>
                , <&macro_release &kp LEFT_SHIFT>
                , <&macro_release &kp LEFT_CONTROL>
                ;
        };
        select_to_line_end: select_to_line_end {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_SHIFT>
                , <&macro_tap &kp END>
                , <&macro_release &kp LEFT_SHIFT>
                ;
        };
        cursor_wiggle: cursor_wiggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp DOWN_ARROW>
                , <&macro_tap &kp UP_ARROW>
                , <&macro_tap &kp RIGHT_ARROW>
                , <&macro_tap &kp LEFT_ARROW>
                ;
        };
        select_word: select_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_CONTROL>
                , <&macro_tap &kp LEFT_ARROW>
                , <&macro_release &kp LEFT_CONTROL>
                , <&macro_press &kp LEFT_CONTROL>
                , <&macro_press &kp LEFT_SHIFT>
                , <&macro_tap &kp RIGHT_ARROW>
                , <&macro_release &kp LEFT_SHIFT>
                , <&macro_release &kp LEFT_CONTROL>
                ;
        };
        select_line: select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp HOME>
                , <&macro_press &kp LEFT_SHIFT>
                , <&macro_tap &kp END>
                , <&macro_release &kp LEFT_SHIFT>
                ;
        };
        two_dots: two_dots {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp PERIOD>
                , <&macro_tap &kp PERIOD>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_f11_base_26 {
            key-positions = <9 22>;
            bindings = <&kp F11>;
            layers = <LAYER_Base>;
        };
        combo_f11_autoshift_27 {
            key-positions = <1 22>;
            bindings = <&kp F11>;
            layers = <LAYER_Autoshift>;
        };
        combo_f12_base_28 {
            key-positions = <10 23>;
            bindings = <&kp F12>;
            layers = <LAYER_Base>;
        };
        combo_f12_autoshift_29 {
            key-positions = <1 23>;
            bindings = <&kp F12>;
            layers = <LAYER_Autoshift>;
        };
        combo_toggle_gaming_base_30 {
            key-positions = <53 64>;
            bindings = <&tog LAYER_Gaming>;
            layers = <LAYER_Base>;
        };
        combo_toggle_gaming_gaming_31 {
            key-positions = <53 64>;
            bindings = <&tog LAYER_Gaming>;
            layers = <LAYER_Gaming>;
        };
        combo_caps_lock_right_base_32 {
            key-positions = <74 79>;
            bindings = <&kp CAPSLOCK>;
            layers = <LAYER_Base>;
        };
        combo_caps_lock_right_autoshift_33 {
            key-positions = <1 2>;
            bindings = <&kp CAPSLOCK>;
            layers = <LAYER_Autoshift>;
        };
        combo_caps_lock_left_base_34 {
            key-positions = <78 71>;
            bindings = <&kp CAPSLOCK>;
            layers = <LAYER_Base>;
        };
        combo_caps_lock_left_autoshift_35 {
            key-positions = <1 2>;
            bindings = <&kp CAPSLOCK>;
            layers = <LAYER_Autoshift>;
        };
        combo_caps_word_left_base_36 {
            key-positions = <77 76>;
            bindings = <&caps_word>;
            layers = <LAYER_Base>;
        };
        combo_caps_word_left_autoshift_37 {
            key-positions = <1 2>;
            bindings = <&caps_word>;
            layers = <LAYER_Autoshift>;
        };
        combo_caps_word_right_base_38 {
            key-positions = <80 81>;
            bindings = <&caps_word>;
            layers = <LAYER_Base>;
        };
        combo_caps_word_right_autoshift_39 {
            key-positions = <1 2>;
            bindings = <&caps_word>;
            layers = <LAYER_Autoshift>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0_Base {
            display-name = "Base";
            bindings = <
                &kp ESC          &kp F1             &kp F2            &kp F3               &kp F4              &kp F5                                                                                               &kp F6                           &kp F7                                 &kp F8                     &kp F9                  &kp F10                          &kp F11
                &kp EQUAL        &kp NUMBER_1       &kp NUMBER_2      &kp NUMBER_3         &kp NUMBER_4        &kp NUMBER_5                                                                                         &kp NUMBER_6                     &kp NUMBER_7                           &kp NUMBER_8               &kp NUMBER_9            &kp NUMBER_0                     &kp MINUS
                &kp TAB          &kp Q              &kp W             &kp E                &kp R               &kp T                                                                                                &kp Y                            &kp U                                  &kp I                      &kp O                   &kp P                            &kp BACKSLASH
                &kp ESCAPE       &hrm_pinky LGUI A  &hrm_ring LALT S  &hrm_middle LCTRL D  &hrm_index LSHFT F  &kp G                                                                                                &kp H                            &hrm_index_right RSHFT J               &hrm_middle_right RCTRL K  &hrm_ring_right LALT L  &hrm_pinky_right RGUI SEMICOLON  &kp SINGLE_QUOTE
                &kp GRAVE        &kp Z              &kp X             &kp C                &kp V               &kp B                                                                                                &kp N                            &kp M                                  &kp COMMA                  &kp PERIOD              &kp SLASH                        &kp PAGE_UP
                &mo LAYER_Magic  &kp HOME           &kp END           &kp LEFT_ARROW       &kp RIGHT_ARROW                                                                                                                                           &kp UP_ARROW                           &kp DOWN_ARROW             &kp LEFT_BRACKET        &kp RIGHT_BRACKET                &kp PAGE_DOWN
                                                                                                                             &kp LEFT_SHIFT                       &kp LEFT_CONTROL  &mo LAYER_Lower  &kp LEFT_GUI   &kp RIGHT_CONTROL                &kp RIGHT_SHIFT
                                                                                                                             &thumb_layer LAYER_Cursor BACKSPACE  &kp DELETE        &kp LEFT_ALT     &kp RIGHT_ALT  &thumb_layer LAYER_Mouse RETURN  &thumb_space_layer LAYER_Symbol SPACE
            >;
        };

        layer_1_Typing {
            display-name = "Typing";
            bindings = <
                &trans           &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans         &trans
                &trans           &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans         &trans
                &trans           &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans         &trans
                &trans           &kp A   &kp S   &kp D   &kp F   &trans                                  &trans  &kp J   &kp K   &kp L   &kp SEMICOLON  &trans
                &trans           &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans         &trans
                &mo LAYER_Magic  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans         &trans
                                                                         &trans  &trans  &trans  &trans  &trans  &trans
                                                                         &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2_Autoshift {
            display-name = "Autoshift";
            bindings = <
                &trans                      &trans                            &trans                            &trans                            &trans                            &trans                                                            &trans                            &trans                            &trans                            &trans                                    &trans                                      &trans
                &autoshift LS(EQUAL) EQUAL  &autoshift LS(NUMBER_1) NUMBER_1  &autoshift LS(NUMBER_2) NUMBER_2  &autoshift LS(NUMBER_3) NUMBER_3  &autoshift LS(NUMBER_4) NUMBER_4  &autoshift LS(NUMBER_5) NUMBER_5                                  &autoshift LS(NUMBER_6) NUMBER_6  &autoshift LS(NUMBER_7) NUMBER_7  &autoshift LS(NUMBER_8) NUMBER_8  &autoshift LS(NUMBER_9) NUMBER_9          &autoshift LS(NUMBER_0) NUMBER_0            &autoshift LS(MINUS) MINUS
                &trans                      &autoshift LS(Q) Q                &autoshift LS(W) W                &autoshift LS(E) E                &autoshift LS(R) R                &autoshift LS(T) T                                                &autoshift LS(Y) Y                &autoshift LS(U) U                &autoshift LS(I) I                &autoshift LS(O) O                        &autoshift LS(P) P                          &autoshift LS(BACKSLASH) BACKSLASH
                &trans                      &autoshift LS(A) A                &autoshift LS(S) S                &autoshift LS(D) D                &autoshift LS(F) F                &autoshift LS(G) G                                                &autoshift LS(H) H                &autoshift LS(J) J                &autoshift LS(K) K                &autoshift LS(L) L                        &autoshift LS(SEMICOLON) SEMICOLON          &autoshift LS(SINGLE_QUOTE) SINGLE_QUOTE
                &autoshift LS(GRAVE) GRAVE  &autoshift LS(Z) Z                &autoshift LS(X) X                &autoshift LS(C) C                &autoshift LS(V) V                &autoshift LS(B) B                                                &autoshift LS(N) N                &autoshift LS(M) M                &autoshift LS(COMMA) COMMA        &autoshift LS(PERIOD) PERIOD              &autoshift LS(SLASH) SLASH                  &trans
                &mo LAYER_Magic             &trans                            &trans                            &trans                            &trans                                                                                                                                &trans                            &trans                            &autoshift LS(LEFT_BRACKET) LEFT_BRACKET  &autoshift LS(RIGHT_BRACKET) RIGHT_BRACKET  &trans
                                                                                                                                                                                                                      &trans  &trans  &trans  &trans  &trans                            &trans
                                                                                                                                                                                                                      &trans  &trans  &trans  &trans  &trans                            &trans
            >;
        };

        layer_3_Gaming {
            display-name = "Gaming";
            bindings = <
                &trans  &kp ESCAPE        &kp P         &kp O         &kp N         &kp BACKSPACE                                                                &kp F1          &kp F2           &kp F3            &kp F4             &kp F5         &trans
                &kp M   &kp NUMBER_6      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0                                                                 &kp F6          &kp F7           &kp F8            &kp F9             &kp F10        &kp F11
                &kp I   &kp NUMBER_1      &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                                                 &kp Y           &kp U            &kp I             &kp O              &kp P          &kp F12
                &kp T   &kp TAB           &kp Q         &kp W         &kp E         &kp R                                                                        &kp H           &kp J            &kp K             &kp L              &kp SEMICOLON  &kp SINGLE_QUOTE
                &kp G   &kp LEFT_SHIFT    &kp A         &kp S         &kp D         &kp F                                                                        &kp N           &kp M            &kp COMMA         &kp PERIOD         &kp SLASH      &kp BACKSLASH
                &kp B   &kp LEFT_CONTROL  &kp Z         &kp X         &kp C                                                                                                      &kp MINUS        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL      &kp GRAVE
                                                                                                   &kp LEFT_SHIFT  &kp LEFT_ALT      &kp V       &kp ESCAPE      &kp UP_ARROW    &kp RETURN
                                                                                                   &kp SPACE       &kp LEFT_CONTROL  &kp RETURN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
