        layer_4_Cursor {
            display-name = "Cursor";
            bindings = <
                &trans     &none         &none         &none             &none           &none                                               &none                &none              &none          &none           &none            &trans
                &none      &kp ESCAPE    &kp INSERT    &kp LS(TAB)       &kp DELETE      &kp LS(LG(S))                                       &none                &none              &none          &none           &none            &none
                &none      &kp RETURN    &kp SPACE     &kp TAB           &kp BACKSPACE   &kp LC(X)                                           &kp LC(X)            &kp LS(TAB)        &kp LC(Z)      &kp LC(Y)       &kp TAB          &none
                &sk LSHFT  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LC(C)                                           &kp LC(C)            &kp LEFT_ARROW     &kp UP_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &sk RSHFT
                &kp LC(L)  &kp LC(A)     &select_line  &select_word      &kp LC(F)       &kp LC(V)                                           &kp LC(V)            &kp HOME           &kp PAGE_UP    &kp PAGE_DOWN   &kp END          &kp LC(L)
                &kp LC(K)  &kp LC(Z)     &kp LC(Y)     &kp LC(LS(G))     &kp LC(G)                                                                                &kp LC(F)          &kp LC(LS(G))  &kp LC(G)       &kp LC(H)        &kp LC(K)
                                                                                                        &none  &none  &none  &cursor_wiggle  &select_to_line_end  &select_next_word
                                                                                                        &none  &none  &none  &kp LC(A)       &select_line         &select_word
            >;
        };

        layer_5_Symbol {
            display-name = "Symbol";
            bindings = <
                &trans            &none             &none                 &none                  &none              &none                                                                           &none          &none                 &none             &none       &none          &trans
                &none             &kp GRAVE         &kp LS(NUMBER_9)      &kp LS(NUMBER_0)       &kp SEMICOLON      &kp COMMA                                                                       &none          &none                 &none             &none       &none          &none
                &kp LS(NUMBER_1)  &kp LEFT_BRACKET  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp RIGHT_BRACKET  &kp LS(SLASH)                                                                   &kp PERIOD     &kp DELETE            &kp LS(TAB)       &kp INSERT  &kp ESCAPE     &none
                &kp LS(NUMBER_3)  &kp LS(NUMBER_6)  &kp EQUAL             &kp LS(MINUS)          &kp LS(NUMBER_4)   &kp LS(NUMBER_8)                                                                &kp COMMA      &kp BACKSPACE         &kp TAB           &kp SPACE   &kp RETURN     &none
                &kp LS(GRAVE)     &kp LS(COMMA)     &kp LS(BACKSLASH)     &kp MINUS              &kp LS(PERIOD)     &kp SLASH                                                                       &kp SEMICOLON  &kp LS(SINGLE_QUOTE)  &kp SINGLE_QUOTE  &kp GRAVE   &kp BACKSLASH  &none
                &two_dots         &kp LS(NUMBER_7)  &kp SINGLE_QUOTE      &kp LS(SINGLE_QUOTE)   &kp LS(EQUAL)                                                                                                     &sk RSHFT             &sk RCTRL         &sk RALT    &sk RGUI       &none
                                                                                                                                      &kp BACKSLASH     &kp PERIOD         &kp LS(NUMBER_8)  &none  &none          &none
                                                                                                                                      &kp LS(NUMBER_5)  &kp LS(SEMICOLON)  &kp LS(NUMBER_2)  &none  &none          &none
            >;
        };

        layer_6_Mouse {
            display-name = "Mouse";
            bindings = <
                &trans  &none           &none                &none                &none                &none                                                              &none           &none                &none                &none                &none              &trans
                &none   &none           &none                &none                &none                &none                                                              &none           &none                &none                &none                &none              &none
                &none   &none           &msc SCRL_LEFT       &mmv MOVE_UP         &msc SCRL_RIGHT      &none                                                              &msc SCRL_LEFT  &mkp LCLK            &mkp MCLK            &mkp RCLK            &msc SCRL_RIGHT    &none
                &none   &msc SCRL_UP    &mmv MOVE_LEFT       &mmv MOVE_DOWN       &mmv MOVE_RIGHT      &msc SCRL_UP                                                       &msc SCRL_UP    &mo LAYER_MouseFast  &mo LAYER_MouseWarp  &mo LAYER_MouseSlow  &kp K_APPLICATION  &mkp MB4
                &none   &msc SCRL_DOWN  &mo LAYER_MouseSlow  &mo LAYER_MouseWarp  &mo LAYER_MouseFast  &msc SCRL_DOWN                                                     &msc SCRL_DOWN  &mmv MOVE_LEFT       &mmv MOVE_UP         &mmv MOVE_DOWN       &mmv MOVE_RIGHT    &mkp MB5
                &none   &none           &kp LC(X)            &kp LC(C)            &kp LC(V)                                                                                               &kp RIGHT_SHIFT      &kp RIGHT_CONTROL    &kp RIGHT_ALT        &kp RIGHT_GUI      &none
                                                                                                                       &mkp MCLK  &kp K_APPLICATION  &mkp MB5  &kp LC(X)  &kp LC(C)       &kp LC(V)
                                                                                                                       &mkp LCLK  &mkp RCLK          &mkp MB4  &none      &none           &none
            >;
        };

        layer_7_MouseSlow {
            display-name = "MouseSlow";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans
                                                                &trans  &trans  &trans  &trans  &trans  &trans
                                                                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_8_MouseFast {
            display-name = "MouseFast";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans
                                                                &trans  &trans  &trans  &trans  &trans  &trans
                                                                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_9_MouseWarp {
            display-name = "MouseWarp";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans
                                                                &trans  &trans  &trans  &trans  &trans  &trans
                                                                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_10_Lower {
            display-name = "Lower";
            bindings = <
                &trans           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_PREVIOUS  &kp C_NEXT       &kp C_PLAY_PAUSE                                          &kp C_MUTE        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none            &kp PAUSE_BREAK  &trans
                &trans           &none                 &none                 &none           &none            &kp HOME                                                  &kp LS(NUMBER_9)  &kp KP_NUMLOCK     &kp EQUAL        &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp PRINTSCREEN
                &trans           &none                 &none                 &kp UP_ARROW    &none            &kp END                                                   &kp LS(NUMBER_0)  &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS     &kp SCROLLLOCK
                &trans           &none                 &kp LEFT_ARROW        &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_UP                                               &kp LS(NUMBER_5)  &kp KP_NUMBER_4    &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &none
                &trans           &kp K_APPLICATION     &none                 &kp F11         &kp F12          &kp PAGE_DOWN                                             &kp COMMA         &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER     &trans
                &mo LAYER_Magic  &kp CAPSLOCK          &kp INSERT            &kp F11         &kp F12                                                                                      &kp KP_NUMBER_0    &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER     &trans
                                                                                                                                &trans  &trans  &to LAYER_Base  &trans  &trans            &trans
                                                                                                                                &trans  &trans  &trans          &trans  &trans            &trans
            >;
        };

        layer_11_Magic {
            display-name = "Magic";
            bindings = <
                &trans          &none            &none             &none            &none            &none                                                                 &none  &none  &none  &bt BT_CLR  &bt BT_CLR_ALL  &trans
                &to LAYER_Base  &none            &to LAYER_Typing  &none            &none            &to LAYER_Autoshift                                                   &none  &none  &none  &none       &none           &none
                &none           &rgb_ug RGB_SPI  &rgb_ug RGB_SAI   &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                                       &none  &none  &none  &none       &none           &none
                &bootloader     &rgb_ug RGB_SPD  &rgb_ug RGB_SAD   &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                                       &none  &none  &none  &none       &none           &bootloader
                &sys_reset      &none            &none             &none            &none            &none                                                                 &none  &none  &none  &none       &none           &sys_reset
                &none           &none            &none             &none            &none                                                                                         &none  &none  &none       &none           &none
                                                                                                                          &bt BT_SEL 2  &bt BT_SEL 3  &none         &none  &none  &none
                                                                                                                          &bt BT_SEL 0  &bt BT_SEL 1  &out OUT_USB  &none  &none  &none
            >;
        };
    };
};

&trackball_peripheral_listener {
    override_0 {
        layers = <LAYER_MouseSlow>;
        input-processors = <&zip_xy_scaler 1 9>;
    };
    override_1 {
        layers = <LAYER_MouseFast>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
    override_2 {
        layers = <LAYER_MouseWarp>;
        input-processors = <&zip_xy_scaler 12 1>;
    };
};

&trackball_central_listener {
    input-processors = <&zip_xy_scaler 1 3>, <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>;
    override_0 {
        layers = <LAYER_MouseSlow>;
        input-processors = <&zip_scroll_scaler 1 9>;
    };
    override_1 {
        layers = <LAYER_MouseFast>;
        input-processors = <&zip_scroll_scaler 3 1>;
    };
    override_2 {
        layers = <LAYER_MouseWarp>;
        input-processors = <&zip_scroll_scaler 12 1>;
    };
};
