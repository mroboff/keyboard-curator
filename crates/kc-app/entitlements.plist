<plist version="1.0">
<!-- Entitlements for the hardened runtime, which notarization requires.
     The app is deliberately empty here: it is not sandboxed, so it needs
     no sandbox grants to reach USB and serial devices or the user's files,
     and it runs no JIT (GPUI ships precompiled Metal shaders), so it needs
     none of the code-signing exceptions such as
     com.apple.security.cs.allow-unsigned-executable-memory. Add a key only
     when a feature is shown to need it. -->
<dict/>
</plist>
